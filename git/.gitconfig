[user]
  name = Ramza
  email = ramza@ramza.cc

[init]
  defaultBranch = main

[core]
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[credential]
  helper = cache --timeout=28800

[merge]
  conflictStyle = zdiff3

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
