{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },

  "sway/window": {
    "max-length": 70,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1"
    }
  },

  "network": {
    "interval": 3,
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET {ifname}",
    "format-linked": "NET {ifname}",
    "format-disconnected": "NET down",
    "tooltip-format-wifi": "{ifname}\n{ipaddr}/{cidr}\n{signalStrength}% signal",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "No network connection",
    "on-click": "foot -e bash -lc 'nmcli device status; printf \"\\nPress Enter to close...\"; read -r'",
    "on-click-right": "bash -lc 'if [ \"$(nmcli -t -f WIFI general)\" = enabled ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "tooltip-format": "{desc}",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT +{capacity}%",
    "format-plugged": "BAT AC",
    "tooltip-format": "{timeTo}\n{power:.1f} W"
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  }
}
